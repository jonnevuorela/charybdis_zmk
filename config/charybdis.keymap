#include "keys_de_swiss.h"
#include <dt-bindings/zmk/mouse.h>
#include <behaviors/mouse_keys.dtsi>
#include <behaviors.dtsi>
#include <dt-bindings/zmk/bt.h>
#include <dt-bindings/zmk/ext_power.h>
#include <dt-bindings/zmk/keys.h>
#include <dt-bindings/zmk/pointing.h>

// / {
//     chosen { zmk,matrix_transform = &default_transform; };
// };

/ {
    /* Note: trackball listeners are defined in the shield overlays
     * since the trackball is only present on the right half.
     * The keymap should not define them here to avoid linker errors
     * when building for the left half.
     */
    // #define QUERTZ    0
    // #define NUMBERS   1
    // #define NAV-FUN   2
    // #define MAC       3
    // #define MAC-NUM   4
    // #define MAC-NAV   5
    // #define GAME      6
    // #define GAME-NUM  7
    // #define GAME-NAV  8
    // #define SCROLL    9
    // #define SNIPER   10
    // #define FN       11

    combos {
        compatible = "zmk,combos";

        to-LINUX {
            bindings = <&to 0>;
            key-positions = <50 51>;
            layers = <3 7>;
        };

        to-GAME {
            bindings = <&to 3>;
            key-positions = <47 36>;
            layers = <0 7>;
        };

        to-FN {
            bindings = <&to 7>;
            key-positions = <41 42>;
            layers = <0 3>;
        };

        caps_word {
            bindings = <&caps_word>;
            key-positions = <31 28>;
        };

        rh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <43 44>;
        };

        rh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <44 45>;
        };

        rh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <44 45 43>;
        };

        lh_leftClick {
            bindings = <&mkp LCLK>;
            key-positions = <40 39>;
        };

        lh_rightClick {
            bindings = <&mkp RCLK>;
            key-positions = <38 39>;
        };

        lh_middleClick {
            bindings = <&mkp MCLK>;
            key-positions = <38 39 40>;
        };

        CAPZ {
            bindings = <&kp CAPSLOCK>;
            key-positions = <24 25>;
        };

        left_alt {
            bindings = <&kp LEFT_ALT>;
            key-positions = <52 51>;
            layers = <0>;
        };
    };

    behaviors {
        hmr: hmr {
            compatible = "zmk,behavior-hold-tap";
            label = "HMR";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <0 1 2 3 4 5 12 13 14 15 16 17 24 25 26 27 28 29 36 37 38 39 40 41 48 49 50 53 54 51 52 55>;
            hold-trigger-on-release;
        };

        hml: hml {
            compatible = "zmk,behavior-hold-tap";
            label = "HML";
            bindings = <&kp>, <&kp>;

            #binding-cells = <2>;
            tapping-term-ms = <190>;
            quick-tap-ms = <175>;
            flavor = "balanced";
            hold-trigger-key-positions = <48 49 50 53 54 51 52 55 6 7 8 9 10 11 18 19 20 21 22 23 30 31 32 33 34 35 42 43 44 45 46 47 51 52>;
            hold-trigger-on-release;
        };
    };

    keymap {
        compatible = "zmk,keymap";

        default_linux_layer {
            label = "LINUX";
            bindings = <
&kp ESCAPE        &kp N1  &kp N2  &kp N3         &kp N4    &kp N5       &kp N6         &kp N7  &kp N8        &kp N9         &kp N0       &kp RBKT
&kp TAB           &kp Q   &kp W   &kp E          &kp R     &kp T        &kp Y          &kp U   &kp I         &kp O          &kp P        &kp LBKT
&kp LEFT_CONTROL  &kp A   &kp S   &kp D          &kp F     &kp G        &kp H          &kp J   &kp K         &kp L          &kp SEMI     &kp APOSTROPHE
&kp LEFT_SHIFT    &kp Z   &kp X   &kp C          &kp V     &kp B        &kp N          &kp M   &kp DE_COMMA  &kp DE_PERIOD  &lt 6 SLASH  &kp BACKSPACE
                                  &kp LEFT_META  &mo 2     &kp SPACE    &kp RETURN     &mo 1
                                                 &mkp MB1  &mkp MB2     &kp RIGHT_ALT
            >;
        };

        linux_raise_layer {
            label = "LINUX-NUM";
            bindings = <
&trans            &kp LS(RA(NUMBER_1))  &kp LS(RA(NUMBER_2))      &kp LS(RA(NUMBER_3))      &kp LS(RA(NUMBER_4))            &kp LS(RA(NUMBER_5))    &kp LS(RA(NUMBER_6))  &kp LS(RA(NUMBER_7))  &kp LS(RA(NUMBER_8))     &kp LS(RA(NUMBER_9))      &kp LS(RA(NUMBER_0))  &kp DE_ACUTE
&kp DE_LESS_THAN  &kp EXCLAMATION       &kp AT                    &kp HASH                  &kp DLLR                        &kp PERCENT             &kp CARET             &kp AMPERSAND         &kp DE_LEFT_PARENTHESIS  &kp DE_RIGHT_PARENTHESIS  &kp DE_ASTERISK       &kp TILDE
&kp GRAVE         &hml LEFT_CONTROL N1  &hml LEFT_ALT DE_SECTION  &hml LEFT_GUI DE_EQUAL    &hml LEFT_SHIFT LS(DE_SECTION)  &kp LA(N)               &kp MINUS             &kp EQUAL             &kp RA(N8)               &kp RA(N9)                &kp BACKSLASH         &kp LESS_THAN
&kp LEFT_SHIFT    &trans                &trans                    &hml LA(DE_N8) LA(DE_N5)  &hml LA(DE_N9) LA(DE_N6)        &kp DE_UMLAUT           &kp UNDER             &kp PLUS              &kp RS(RA(NUMBER_8))     &kp RA(RS(N9))            &kp PIPE              &kp RIGHT_ALT
                                                                  &kp LALT                  &kp BACKSPACE                   &trans                  &trans                &kp DE_N0
                                                                                            &trans                          &trans                  &kp RIGHT_ALT
            >;
        };

        linux_lower_layer {
            label = "LINUX-NAV";
            bindings = <
&kp ESC  &kp F1        &kp F2        &kp F3          &kp F4            &kp F5          &kp F6          &kp F7                &kp F8        &kp F9           &kp F10       &kp F11
&trans   &kt NUMBER_1  &kp NUMBER_2  &kp NUMBER_3    &kp NUMBER_4      &kp NUMBER_5    &kp NUMBER_6    &kp NUMBER_7          &kp NUMBER_8  &kp NUMBER_9     &kp NUMBER_0  &trans
&trans   &trans        &trans        &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT      &kp LEFT_ARROW  &kp DOWN_ARROW        &kp UP_ARROW  &kp RIGHT_ARROW  &trans        &trans
&trans   &trans        &trans        &trans          &trans            &trans          &trans          &trans                &trans        &trans           &trans        &trans
                                     &trans          &trans            &trans          &trans          &kp LS(LG(NUMBER_5))
                                                     &trans            &trans          &trans
            >;
        };

        default_game_layer {
            label = "GAME";
            bindings = <
&kp ESCAPE  &kp DE_SECTION                  &kp N1           &kp N2           &kp N3             &hml N5 N4        &kp N6       &kp N7              &kp N8                   &kp N9                    &kp N0                          &kp DE_SQT
&kp T       &kp TAB                         &kp Q            &kp W            &kp E              &hml T R          &kp DE_Z     &kp U               &kp I                    &kp O                     &kp P                           &kp DE_U_UMLAUT
&kp G       &kp LEFT_SHIFT                  &kp A            &kp S            &kp D              &hml G F          &kp H        &hmr RIGHT_SHIFT J  &hmr RIGHT_GUI K         &hmr RIGHT_ALT L          &hmr RIGHT_CONTROL DE_O_UMLAUT  &kp DE_A_UMLAUT
&kp B       &hml LEFT_CONTROL DE_LESS_THAN  &hml LEFT_ALT Y  &hml LEFT_GUI X  &hml LEFT_SHIFT C  &hml B V          &kp N        &hmr RIGHT_SHIFT M  &hmr RIGHT_GUI DE_COMMA  &hmr RIGHT_ALT DE_PERIOD  &lt 6 DE_MINUS                  &hmr DELETE RIGHT_SHIFT
                                                             &lt 4 TAB        &kp SPACE          &lt 5 LEFT_GUI    &lt 4 ENTER  &kp BACKSPACE
                                                                              &mkp RCLK          &mkp LCLK         &mo 5
            >;
        };

        game_raise_layer {
            label = "GAME-NUM";
            bindings = <
&trans                        &trans                &trans                      &trans                              &trans                                &trans            &trans               &trans                  &trans                          &trans                           &trans                         &trans
&kp DE_SECTION                &kp DE_EXCLAMATION    &kp DE_DOUBLE_QUOTES        &hml DE_HASH DE_ASTERISK            &hml DE_CENT DE_C_CEDILLA             &kp DE_PERCENT    &hmr DE_NOT DE_AMPS  &hmr DE_SLASH DE_N7     &hmr DE_LEFT_PARENTHESIS DE_N8  &hmr DE_RIGHT_PARENTHESIS DE_N9  &hmr DE_ACUTE DE_SINGLE_QUOTE  &hmr DE_GRAVE DE_QUESTION
&hml DE_POUND_SIGN DE_DOLLAR  &hml LEFT_CONTROL N1  &hml LEFT_ALT DE_LESS_THAN  &hml LEFT_GUI DE_EQUAL              &hml LEFT_SHIFT DE_GREATER_THAN       &kp DE_TILDE      &kp DE_PLUS          &hmr RIGHT_SHIFT DE_N4  &hmr RIGHT_GUI DE_N5            &hmr RIGHT_ALT DE_N6             &hmr RIGHT_CONTROL ENTER       &hmr DE_BROKEN_BAR DE_PIPE
&kp DE_CARET                  &trans                &kp DE_AT                   &hml DE_LEFT_BRACKET DE_LEFT_BRACE  &hml DE_RIGHT_BRACKET DE_RIGHT_BRACE  &kp DE_UMLAUT     &kp DE_MINUS         &kp DE_N1               &kp DE_N2                       &kp DE_N3                        &kp DE_PERIOD                  &kp DE_BACKSLASH
                                                                                &trans                              &kp BACKSPACE                         &trans            &trans               &kp DE_N0
                                                                                                                    &trans                                &trans            &trans
            >;
        };

        game_lower_layer {
            label = "GAME-NAV";
            bindings = <
&trans      &trans    &trans         &trans          &trans            &trans        &trans  &trans           &trans          &trans        &trans           &trans
&kp ESCAPE  &kt F1    &kp F2         &kp F3          &kp F4            &kp F5        &kp F6  &kp F7           &kp F8          &kp F9        &kp F10          &kp F11
&trans      &kp HOME  &kp PAGE_UP    &kp C_PREVIOUS  &kp C_PLAY_PAUSE  &kp C_NEXT    &trans  &kp LEFT_ARROW   &kp DOWN_ARROW  &kp UP_ARROW  &kp RIGHT_ARROW  &kp F12
&trans      &kp END   &kp PAGE_DOWN  &trans          &trans            &trans        &trans  &trans           &trans          &trans        &trans           &trans
                                     &trans          &trans            &trans        &trans  &kp PRINTSCREEN
                                                     &trans            &trans        &trans
            >;
        };

        scroll_layer {
            bindings = <
&trans  &trans  &trans          &trans  &trans          &trans    &trans  &trans           &trans  &trans           &trans  &trans
&trans  &trans  &trans          &trans  &trans          &trans    &trans  &trans           &trans  &trans           &trans  &trans
&trans  &trans  &trans          &trans  &kp LEFT_SHIFT  &trans    &trans  &kp RIGHT_SHIFT  &trans  &trans           &trans  &trans
&trans  &trans  &kp LEFT_SHIFT  &trans  &trans          &trans    &trans  &trans           &trans  &kp RIGHT_SHIFT  &trans  &trans
                                &trans  &trans          &trans    &trans  &trans
                                        &trans          &trans    &trans
            >;

            label = "SCROLL";
        };

        keeb_pref_layer {
            label = "FN";
            bindings = <
&ext_power EP_TOG  &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
&bt BT_CLR         &bt BT_SEL 0  &bt BT_SEL 1  &bt BT_SEL 2  &bt BT_SEL 3  &bt BT_SEL 4    &trans  &trans  &trans  &trans  &trans  &trans
&trans             &trans        &trans        &trans        &trans        &trans          &trans  &trans  &trans  &trans  &trans  &trans
                                               &trans        &trans        &trans          &trans  &trans
                                                             &trans        &trans          &trans
            >;
        };
    };
};
